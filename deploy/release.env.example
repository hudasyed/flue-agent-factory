# SSH URLs are recommended so credentials stay out of the mirror configuration.
FLUE_GIT_URL=git@github.com:OWNER/flue-agent-factory.git
FLUE_GIT_REF=main

# Set to 1 after the deployment host has the trusted signing keys needed by
# `git verify-commit`.
FLUE_REQUIRE_SIGNED_COMMITS=0

# Current and previous releases are always retained. Set to 0 to disable
# automatic pruning entirely.
FLUE_KEEP_RELEASES=5
