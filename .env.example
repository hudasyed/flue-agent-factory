# Copy this file to /srv/flue-agent/secrets/deployment.env on the deployment
# host, keep it mode 0600, and replace every required placeholder.
TELEGRAM_MODE=disabled
TELEGRAM_OWNER_USER_ID=
LAN_IPV4_PREFIXES=192.168.1.
PUBLIC_TELEGRAM_WEBHOOK_URL=
TRUST_LAN_PROXY=0
ALLOW_NON_LAN_UI=0

# Bitwarden Secrets Manager. These are secret names, not secret values.
BWS_ACCESS_TOKEN=
BWS_PROJECT_ID=
BWS_HOST_BINARY_PATH=/absolute/path/to/bws
BWS_TELEGRAM_SECRET_KEY=TELEGRAM_BOT_TOKEN
BWS_MINIMAX_SECRET_KEY=MINIMAX_API_KEY
BWS_DATABASE_SECRET_KEY=DATABASE_URL
BWS_TELEGRAM_WEBHOOK_SECRET_KEY=TELEGRAM_WEBHOOK_SECRET_TOKEN

# Host firewall settings for the LAN dashboard.
DASHBOARD_LAN_INTERFACE=eth0
DASHBOARD_LAN_CIDR=192.168.1.0/24

# Optional infrastructure inspection/change targets. Put their SSH host
# definitions in a separate root-owned file; see deploy/ssh-config.example.
INFRA_SSH_TARGETS=
INFRA_SSH_CONFIG_SOURCE=/srv/flue-agent/secrets/infra-ssh-config

# Optional s6-managed gateway to stop while this service owns Telegram polling.
REPLACED_GATEWAY_CONTAINER=
REPLACED_GATEWAY_PROFILE=

WORKSPACE_MEMORY_LIMIT=4g
WORKSPACE_CPU_LIMIT=4
WORKSPACE_PIDS_LIMIT=512
DATABASE_POOL_SIZE=10
FACTORY_GIT_USER_NAME="Flue Software Factory"
FACTORY_GIT_USER_EMAIL=flue-agent@localhost
